rules_version = '2';

// FASE 0 — colchón temporal mientras se construye el login real por NIP
// (custom token vía Cloud Function). Exige sesión autenticada (por ahora
// anónima) para cerrar el acceso público abierto que Firebase iba a
// bloquear. Pendiente: reglas con validación de esquema por colección
// una vez que exista auth real basada en el NIP verificado en servidor.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
